# Copy this file to .env for local development (.env is git-ignored).
# On Vercel, add the same names under Project -> Settings -> Environment Variables.

# REQUIRED. One key powers story text, illustration and narration.
# Create it free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OPTIONAL model overrides. The defaults below come from Google's cookbook; change them
# only if Google renames a model or a model has no free tier on your account.
# Run `python scripts/check_gemini.py` to test all three with your key.
# GEMINI_TEXT_MODEL=gemini-flash-latest
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_TTS_VOICE=Kore

# OPTIONAL: set to true to always serve the built-in sample story, even when a key is set.
# DEMO_MODE=false

# OPTIONAL seconds to wait for one Gemini call (keep below the 60s Vercel function limit).
# GEMINI_TIMEOUT=55
